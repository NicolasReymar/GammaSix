{
  "contentType": "scenario",
  "id": "scenario_capture_rescue_test",
  "name": "Acciones declarativas - Prueba",
  "description": "Escenario técnico donde la muerte de una unidad marcada activa reglas guardadas: destruye entidades del propietario, crea un edificio prop y permite una canalización que genera una unidad nueva.",
  "maxTeams": 2,
  "maxPlayers": 4,
  "fixedTeams": false,
  "gameModeId": "base:game-mode.normal",
  "participantConfiguration": {
    "maximumHumanPlayers": 4,
    "maximumParticipants": 4
  },
  "worldSize": {
    "width": 48,
    "height": 48
  },
  "terrain": {
    "defaultTerrainId": "praderas_primavera",
    "tiles": []
  },
  "entityCatalog": {
    "includeGameModeDefaults": true,
    "spawnableEntityIds": [
      "building.captured-player-prop"
    ]
  },
  "spawnPoints": [
