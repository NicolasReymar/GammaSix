.selected-entity-hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.selected-entity-panel {
    position: absolute;
    left: 24px;
    bottom: 20px;
    width: 360px;
    max-height: 300px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgba(8, 24, 18, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(91, 178, 139, 0.66);
    border-right-color: rgba(91, 178, 139, 0.66);
    border-top-color: rgba(91, 178, 139, 0.66);
    border-bottom-color: rgba(91, 178, 139, 0.66);
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.selected-entity-title {
    color: rgb(244, 250, 247);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.selected-entity-summary {
    color: rgb(158, 188, 175);
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 12px;
    white-space: normal;
}

.selected-entity-attributes-scroll {
    max-height: 180px;
}

.selected-entity-attributes-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.selected-entity-attribute-chip {
    color: rgb(231, 245, 238);
    font-size: 12px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(51, 127, 94, 0.64);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.selected-entity-empty {
    color: rgb(144, 174, 161);
    font-size: 13px;
    white-space: normal;
}

.selected-entity-panel.hud-panel-editing-unlocked {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 216, 74);
    border-right-color: rgb(255, 216, 74);
    border-top-color: rgb(255, 216, 74);
    border-bottom-color: rgb(255, 216, 74);
}
