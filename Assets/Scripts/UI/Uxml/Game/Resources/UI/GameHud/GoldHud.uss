.gold-hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.gold-hud-panel {
    position: absolute;
    top: 20px;
    right: 24px;
    min-width: 240px;
    min-height: 58px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(10, 13, 12, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.65);
    border-right-color: rgba(255, 255, 255, 0.65);
    border-top-color: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(255, 255, 255, 0.65);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.gold-hud-label {
    color: white;
    font-size: 25px;
    unity-font-style: bold;
    margin-right: 16px;
}

.gold-hud-value {
    min-width: 110px;
    color: rgb(255, 221, 92);
    font-size: 25px;
    unity-font-style: bold;
    unity-text-align: middle-right;
}

.gold-hud-panel.hud-panel-editing-unlocked {
    border-left-color: rgb(255, 216, 74);
    border-right-color: rgb(255, 216, 74);
    border-top-color: rgb(255, 216, 74);
    border-bottom-color: rgb(255, 216, 74);
}
