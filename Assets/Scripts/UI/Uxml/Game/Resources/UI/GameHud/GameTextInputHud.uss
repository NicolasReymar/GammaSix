.game-text-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 282px;
}

.game-text-panel {
    width: 940px;
    max-width: 88%;
    min-height: 166px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 10px;
    background-color: rgba(7, 18, 15, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(78, 145, 116, 0.78);
    border-right-color: rgba(78, 145, 116, 0.78);
    border-top-color: rgba(78, 145, 116, 0.78);
    border-bottom-color: rgba(78, 145, 116, 0.78);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.game-text-panel-focused {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(102, 224, 164);
    border-right-color: rgb(102, 224, 164);
    border-top-color: rgb(102, 224, 164);
    border-bottom-color: rgb(102, 224, 164);
}

.game-text-header,
.game-text-title-row,
.game-text-input-row {
    flex-direction: row;
    align-items: center;
}

.game-text-header {
    min-height: 34px;
    justify-content: space-between;
    margin-left: -16px;
    margin-right: -16px;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(17, 43, 33, 0.88);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(91, 178, 139, 0.24);
}

.game-text-title-row {
    flex-grow: 1;
}

.game-text-title {
    color: rgb(197, 229, 214);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.game-text-channel {
    color: rgb(255, 216, 74);
    font-size: 10px;
    -unity-font-style: bold;
    margin-left: 10px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(255, 216, 74, 0.10);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.game-text-status {
    color: rgb(139, 185, 163);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.game-text-status-error {
    color: rgb(255, 132, 122);
}

.game-text-history {
    height: 76px;
    margin-bottom: 7px;
    background-color: rgba(0, 0, 0, 0.23);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.game-text-message {
    color: rgb(224, 235, 229);
    font-size: 13px;
    white-space: normal;
    margin-bottom: 2px;
}

.game-text-message-system {
    color: rgb(153, 206, 181);
}

.game-text-message-error {
    color: rgb(255, 137, 126);
}

.game-text-input-label {
    min-width: 76px;
    color: rgb(255, 216, 74);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.game-text-input {
    flex-grow: 1;
    height: 34px;
    margin-right: 8px;
    color: rgb(240, 248, 244);
    background-color: rgba(15, 37, 29, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(95, 164, 133, 0.7);
    border-right-color: rgba(95, 164, 133, 0.7);
    border-top-color: rgba(95, 164, 133, 0.7);
    border-bottom-color: rgba(95, 164, 133, 0.7);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.game-text-send-button {
    width: 94px;
    height: 34px;
    color: rgb(238, 250, 244);
    background-color: rgb(28, 112, 74);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-font-style: bold;
}

.game-text-send-button:hover {
    background-color: rgb(38, 137, 93);
}

.game-text-hint {
    color: rgb(112, 154, 135);
    font-size: 11px;
    margin-top: 4px;
    margin-left: 86px;
}
