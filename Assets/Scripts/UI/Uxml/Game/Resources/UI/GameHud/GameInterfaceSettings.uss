.game-interface-settings-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
}

.game-interface-settings-title {
    color: rgb(242, 250, 246);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 9px;
}

.game-interface-settings-description {
    color: rgb(151, 181, 168);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 18px;
}

.game-interface-settings-card {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 15px;
    padding-bottom: 16px;
    margin-bottom: 14px;
    background-color: rgba(16, 43, 34, 0.86);
    border-left-width: 3px;
    border-left-color: rgb(66, 197, 139);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.game-interface-settings-reset-card {
    border-left-color: rgb(197, 91, 91);
}

.game-interface-settings-card-title {
    color: rgb(229, 243, 236);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.game-interface-settings-card-description {
    color: rgb(151, 181, 168);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 13px;
}

.game-interface-settings-button {
    align-self: flex-start;
    min-width: 230px;
    height: 44px;
    padding-left: 18px;
    padding-right: 18px;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.game-interface-settings-save-button {
    background-color: rgb(35, 132, 91);
    border-left-color: rgb(76, 202, 145);
    border-right-color: rgb(76, 202, 145);
    border-top-color: rgb(76, 202, 145);
    border-bottom-color: rgb(76, 202, 145);
}

.game-interface-settings-save-button:hover {
    background-color: rgb(43, 156, 107);
}

.game-interface-settings-reset-button {
    background-color: rgb(119, 50, 51);
    border-left-color: rgb(174, 80, 81);
    border-right-color: rgb(174, 80, 81);
    border-top-color: rgb(174, 80, 81);
    border-bottom-color: rgb(174, 80, 81);
}

.game-interface-settings-reset-button:hover {
    background-color: rgb(144, 58, 60);
}

.game-interface-settings-status {
    min-height: 42px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    color: rgb(113, 222, 168);
    font-size: 14px;
    white-space: normal;
    background-color: rgba(7, 22, 17, 0.64);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
