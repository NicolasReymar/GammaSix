.game-hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.game-hud-top-row {
    position: absolute;
    top: 20px;
    right: 24px;
    flex-direction: row;
    justify-content: flex-end;
}

.game-hud-resource-card {
    min-width: 240px;
    min-height: 58px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(10, 13, 12, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.65);
    border-right-color: rgba(255, 255, 255, 0.65);
    border-top-color: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(255, 255, 255, 0.65);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.game-hud-resource-label {
    color: white;
    font-size: 25px;
    -unity-font-style: bold;
    margin-right: 16px;
}

.game-hud-resource-value {
    min-width: 110px;
    color: rgb(255, 221, 92);
    font-size: 25px;
   -unity-font-style: bold;
   -unity-text-align: middle-right;
}

.game-hud-bottom-row {
    position: absolute;
    left: 24px;
    bottom: 20px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-end;
}

.game-hud-selection-card {
    width: 360px;
    max-height: 300px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgba(10, 13, 12, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.65);
    border-right-color: rgba(255, 255, 255, 0.65);
    border-top-color: rgba(255, 255, 255, 0.65);
    border-bottom-color: rgba(255, 255, 255, 0.65);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.game-hud-title {
    color: white;
    font-size: 22px;
   -unity-font-style: bold;
    white-space: normal;
}

.game-hud-summary {
    color: rgba(255, 255, 255, 0.75);
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 12px;
    white-space: normal;
}

.game-hud-attributes-scroll {
    max-height: 180px;
}

.game-hud-attributes-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.game-hud-attribute-chip {
    color: white;
    font-size: 12px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(68, 131, 111, 0.58);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.game-hud-empty {
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    white-space: normal;
}
