.unit-orders-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.unit-orders-panel {
    position: absolute;
    right: 24px;
    bottom: 20px;
    width: 314px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(12, 19, 25, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(152, 124, 56, 0.72);
    border-right-color: rgba(152, 124, 56, 0.72);
    border-top-color: rgba(152, 124, 56, 0.72);
    border-bottom-color: rgba(152, 124, 56, 0.72);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.unit-orders-header {
    padding-bottom: 8px;
}

.unit-orders-title {
    color: rgb(245, 215, 116);
    font-size: 15px;
    -unity-font-style: bold;
}

.unit-orders-selection {
    color: rgb(166, 180, 188);
    font-size: 11px;
    margin-top: 3px;
}

.unit-orders-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.unit-order-button {
    width: 138px;
    height: 38px;
    margin-right: 5px;
    margin-bottom: 5px;
    color: rgb(235, 239, 241);
    background-color: rgba(39, 53, 62, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(103, 122, 132, 0.8);
    border-right-color: rgba(103, 122, 132, 0.8);
    border-top-color: rgba(103, 122, 132, 0.8);
    border-bottom-color: rgba(103, 122, 132, 0.8);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.unit-order-button:hover {
    background-color: rgba(56, 74, 84, 0.98);
}

.unit-order-button--active {
    color: rgb(255, 242, 190);
    background-color: rgba(116, 80, 25, 0.98);
    border-left-color: rgb(255, 207, 86);
    border-right-color: rgb(255, 207, 86);
    border-top-color: rgb(255, 207, 86);
    border-bottom-color: rgb(255, 207, 86);
}

.unit-order-button--passive {
    background-color: rgba(54, 66, 92, 0.98);
}

.unit-order-button--future {
    opacity: 0.48;
}

.unit-orders-status {
    color: rgb(180, 190, 195);
    font-size: 11px;
    margin-top: 4px;
    white-space: normal;
}
