<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Shared/MainMenuTheme.uss" />
    <ui:VisualElement name="main-menu-panel" class="gs-screen">
        <ui:VisualElement class="gs-top-accent" />
        <ui:VisualElement class="gs-header">
            <ui:VisualElement class="gs-header-main">
                <ui:Label text="UN JUGADOR" class="gs-eyebrow" />
                <ui:Label text="Escaramuza" class="gs-title" />
                <ui:Label text="Selecciona y confirma un escenario antes de iniciar la partida local." class="gs-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="gs-header-actions">
                <ui:Button text="Volver" name="sp-menu-back-button" class="gs-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="gs-content gs-two-column">
            <ui:VisualElement class="gs-card gs-column-main">
                <ui:Label text="Escenarios disponibles" class="gs-card-title" />
                <ui:Label text="La lista se lee desde GameContent cada vez que abres esta pantalla." class="gs-card-description" />
                <ui:VisualElement class="gs-divider" />
                <ui:Foldout text="Explorar escenarios y campañas" name="sp-map-browser-panel" class="gs-foldout" />
                <ui:VisualElement class="gs-footer-actions">
                    <ui:Button text="Confirmar selección" name="sp-select-skirmish-button" class="gs-button gs-button-primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gs-card gs-card-accent gs-column-side">
                <ui:Label text="PARTIDA LOCAL" class="gs-eyebrow" />
                <ui:Label text="Configuración de escaramuza" class="gs-card-title" />
                <ui:Label text="El escenario define jugadores máximos, equipos, terreno, entidades y reglas prioritarias." class="gs-card-description" />
                <ui:VisualElement class="gs-divider" />
                <ui:Label text="Contenido confirmado" class="gs-section-title" />
                <ui:Label text="Ninguna" name="sp-selected-map-label" class="gs-selected-value" />
                <ui:VisualElement class="gs-spacer" />
                <ui:Button text="Iniciar escaramuza" name="sp-menu-start-button" class="gs-button gs-button-primary gs-button-large gs-button-wide" />
                <ui:Label text="Selecciona una escaramuza para iniciar." name="sp-status-label" class="gs-status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
