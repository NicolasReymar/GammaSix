<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Shared/MainMenuTheme.uss" />
    <ui:VisualElement name="main-menu-panel" class="gs-screen">
        <ui:VisualElement class="gs-top-accent" />
        <ui:VisualElement class="gs-header">
            <ui:VisualElement class="gs-header-main">
                <ui:Label text="UN JUGADOR" class="gs-eyebrow" />
                <ui:Label text="Selección de campaña" class="gs-title" />
                <ui:Label text="Pantalla heredada conservada para futuras conexiones del flujo de campaña." class="gs-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="gs-header-actions">
                <ui:Button text="Volver" name="sp-campaign-back-button" class="gs-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="gs-content gs-two-column">
            <ui:VisualElement class="gs-card gs-column-main">
                <ui:Label text="Campañas disponibles" class="gs-card-title" />
                <ui:Foldout text="Explorar campañas" name="sp-campaign-browser-panel" class="gs-foldout" />
                <ui:VisualElement class="gs-footer-actions">
                    <ui:Button text="Confirmar campaña" name="sp-select-campaign-button" class="gs-button gs-button-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="gs-card gs-card-accent gs-column-side">
                <ui:Label text="Campaña seleccionada" class="gs-section-title" />
                <ui:Label text="Ninguna" name="sp-selected-map-label" class="gs-selected-value" />
                <ui:VisualElement class="gs-spacer" />
                <ui:Button text="Iniciar campaña" name="sp-campaign-start-button" class="gs-button gs-button-primary gs-button-large gs-button-wide" />
                <ui:Label text="Selecciona una campaña para iniciar." name="sp-status-label" class="gs-status" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
