<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../../Shared/MainMenuTheme.uss" />
    <ui:VisualElement name="main-menu-panel" class="gs-screen">
        <ui:VisualElement class="gs-top-accent" />
        <ui:VisualElement name="mp-header" class="gs-header">
            <ui:VisualElement class="gs-header-main">
                <ui:Label text="MULTIJUGADOR" class="gs-eyebrow" />
                <ui:Label text="Escaramuza en red" class="gs-title" />
                <ui:Label text="Configura la sesión antes de abrir el lobby." name="mp-screen-subtitle" class="gs-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="gs-header-actions">
                <ui:Button text="Volver" name="mp-menu-back-button" class="gs-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="mp-create-session-view" class="gs-content gs-two-column">
            <ui:ScrollView name="mp-create-session-left" class="gs-card gs-column-main gs-scroll">
                <ui:Label text="Crear sesión" class="gs-card-title" />
                <ui:Label text="Define la identidad del anfitrión y el puerto que utilizarán los clientes." class="gs-card-description" />
                <ui:VisualElement class="gs-divider" />
                <ui:TextField label="Nombre del anfitrión" name="mp-host-name-field" class="gs-field" />
                <ui:IntegerField label="Puerto" name="mp-host-port-field" class="gs-field" />
                <ui:VisualElement class="gs-setting-action-card">
                    <ui:Label text="Antes de abrir la sala" class="gs-card-title-small" />
                    <ui:Label text="Selecciona y confirma el contenido en el panel derecho. El lobby heredará sus límites y reglas." class="gs-card-description" />
                </ui:VisualElement>
                <ui:VisualElement class="gs-spacer" />
                <ui:Button text="Abrir lobby como anfitrión" name="mp-host-button" class="gs-button gs-button-primary gs-button-large gs-button-wide" />
                <ui:Label text="Selecciona y confirma el contenido para crear la sesión." name="mp-network-status-label" class="gs-status" />
            </ui:ScrollView>

            <ui:ScrollView name="mp-create-session-right" class="gs-card gs-column-side gs-scroll">
                <ui:Label text="Contenido de la partida" class="gs-card-title" />
                <ui:Label text="Puedes elegir una campaña o un escenario disponible en GameContent." class="gs-card-description" />
                <ui:VisualElement class="gs-divider" />
                <ui:Label text="Contenido confirmado" class="gs-section-title" />
                <ui:Label text="Ninguno" name="mp-selected-map-label" class="gs-selected-value" />
                <ui:Foldout text="Explorar contenido" name="mp-map-browser-panel" class="gs-foldout" />
                <ui:Button text="Confirmar contenido" name="mp-select-skirmish-button" class="gs-button gs-button-primary gs-button-wide" />
                <ui:VisualElement name="mp-host-preview-panel" class="gs-setting-action-card" />
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="mp-lobby-view" class="gs-content gs-two-column">
            <ui:VisualElement name="mp-players-card" class="gs-card gs-column-main">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                    <ui:Label text="Jugadores y equipos" class="gs-card-title" style="flex-grow: 1;" />
                    <ui:Button text="Headless (0)" name="mp-headless-button" class="gs-button" style="min-width: 142px; margin-left: 12px;" />
                </ui:VisualElement>
                <ui:Label text="Las casillas incluyen jugadores humanos y participantes headless compatibles con el contenido." class="gs-card-description" />
                <ui:VisualElement name="mp-headless-panel" class="gs-setting-action-card" style="display: none; margin-top: 12px;" />
                <ui:VisualElement class="gs-divider" />
                <ui:ScrollView name="mp-player-list" class="gs-scroll" />
            </ui:VisualElement>

            <ui:ScrollView name="mp-settings-card" class="gs-card gs-card-accent gs-column-side gs-scroll">
                <ui:Label text="Configuración de la sala" class="gs-card-title" />
                <ui:Label text="Contenido activo" class="gs-section-title" />
                <ui:Label text="Escenario: Ninguno" name="mp-lobby-content-label" class="gs-selected-value" />
                <ui:VisualElement class="gs-divider" />
                <ui:Toggle label="Colores fijos" name="mp-fixed-colors-toggle" class="gs-toggle" />
                <ui:Toggle label="Equipos fijos" name="mp-fixed-teams-toggle" class="gs-toggle" />
                <ui:VisualElement name="mp-content-overrides-panel" class="gs-setting-action-card" />
                <ui:VisualElement class="gs-divider" />
                <ui:VisualElement class="gs-profile-line">
                    <ui:VisualElement name="mp-all-ready-light" style="width: 14px; height: 14px; margin-right: 10px; background-color: rgb(195, 45, 45); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;" />
                    <ui:Label text="Faltan jugadores humanos por confirmar" name="mp-all-ready-label" class="gs-card-description" />
                </ui:VisualElement>
                <ui:Button text="Marcar listo" name="mp-ready-button" class="gs-button gs-button-wide" />
                <ui:Button text="Iniciar partida" name="mp-menu-start-button" class="gs-button gs-button-primary gs-button-large gs-button-wide" />
                <ui:Label text="Esperando jugadores." name="mp-lobby-status-label" class="gs-status" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
